{
  "name": "local-outlook-mailbox-tool",
  "version": "2.0.0",
  "description": "本地 Outlook OAuth2 IMAP 邮箱聚合桌面工具",
  "author": "Local",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "app:dev": "electron .",
    "app:pack": "electron-builder --dir",
    "app:dist": "electron-builder -m",
    "start": "node server.js",
    "runoutlook": "./runoutlook",
    "check": "node --check server.js && node --check public/app.js && node --check desktop/main.js"
  },
  "build": {
    "appId": "local.outlook.mailbox.tool",
    "productName": "邮箱聚合平台",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "dir"
      ]
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "engines": {
    "node": ">=22.5"
  }
}
